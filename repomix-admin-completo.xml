                                <div class="small text-muted">Motivo: ${escapeHtml(ext.motivo)}</div>
                                <div class="small text-muted">Aprobado por: ${escapeHtml(ext.aprobado_por?.nombre || ext.aprobado_por?.usuario || '—')}</div>
                            </div>
