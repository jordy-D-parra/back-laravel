                ${solicitudes.length > 0 ? `<span style="background: #f59e0b; color: white; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.72rem; font-weight: 600;">📋 ${solicitudes.length} solicitud(es)</span>` : ''}
