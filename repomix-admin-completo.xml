            // ========== PRÉSTAMOS ==========
            ['nombre' => 'ver-prestamos', 'descripcion' => 'Ver listado de préstamos', 'categoria' => 'prestamos'],
            ['nombre' => 'crear-prestamo', 'descripcion' => 'Crear nuevos préstamos', 'categoria' => 'prestamos'],
