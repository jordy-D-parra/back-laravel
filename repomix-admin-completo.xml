                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
                Préstamos (${prestamos.length})
            </div>
        `;

        prestamos.forEach(p => {
            const clase = obtenerClaseEvento(p);
            const colorMap = {
                'prestamo': '#1e3c72',
                'aprobado': '#22c55e',
                'extendido': '#8b5cf6',
                'vencido': '#ef4444',
                'devuelto': '#6c757d',
                'solicitud': '#f59e0b'
