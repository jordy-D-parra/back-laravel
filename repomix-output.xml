<file path="resources/css/admin-entidades.css">
/* ============================================================
   Panel de Entidades Unificado - CSS Profesional
   ============================================================ */

/* ---------- Variables ---------- */
:root {
    --primary-dark: #1e3c72;
    --primary-light: #2a4a8a;
    --primary-lighter: #eef3fc;
    --success: #1e7e34;
    --danger: #c5221f;
    --warning: #f6c23e;
    --gray-bg: #f8f9fc;
    --border-light: #e9ecef;
    --text-muted: #6c757d;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.12);
    --radius-card: 1rem;
    --radius-table: 0.75rem;
}

/* ---------- Stats Cards ---------- */
.stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
}

.stat-card-mini {
    background: white;
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.stat-card-mini::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    background: rgba(30, 60, 114, 0.03);
    border-radius: 50%;
    transform: translate(30%, -30%);
}

.stat-card-mini:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-lighter);
}

.stat-card-mini .stat-info {
    position: relative;
    z-index: 1;
}

.stat-card-mini .stat-info .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1.2;
}

.stat-card-mini .stat-info .stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
}

.stat-card-mini .stat-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-lighter);
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
}

.stat-card-mini:hover .stat-icon-circle {
    background: var(--primary-dark);
    transform: scale(1.05) rotate(-5deg);
}

.stat-card-mini:hover .stat-icon-circle svg {
    stroke: white;
}

.stat-card-mini .stat-icon-circle svg {
    stroke: var(--primary-dark);
    transition: stroke 0.3s ease;
}

/* ---------- Tabs Personalizados ---------- */
.nav-tabs-custom {
    display: flex;
    gap: 0.25rem;
    border-bottom: 2px solid var(--border-light);
    margin-bottom: 0;
    background: white;
    padding: 0 0.5rem;
    border-radius: var(--radius-table) var(--radius-table) 0 0;
}

.nav-tabs-custom .nav-link {
    border: none;
    padding: 0.85rem 1.5rem;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 0;
    background: transparent;
    transition: all 0.3s ease;
    position: relative;
}

.nav-tabs-custom .nav-link:hover {
    color: var(--primary-dark);
    background: var(--primary-lighter);
}

.nav-tabs-custom .nav-link.active {
    color: var(--primary-dark);
    font-weight: 600;
    background: transparent;
}

.nav-tabs-custom .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light));
    border-radius: 3px 3px 0 0;
}

.nav-tabs-custom .nav-link svg {
    stroke: currentColor;
    width: 18px;
    height: 18px;
}

.nav-tabs-custom .nav-link .tab-badge {
    background: var(--primary-lighter);
    color: var(--primary-dark);
    padding: 0.1rem 0.5rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 600;
    margin-left: 4px;
}

.nav-tabs-custom .nav-link.active .tab-badge {
    background: var(--primary-dark);
    color: white;
}

/* ---------- Barra de cada tab ---------- */
.tab-header-bar {
    background: white;
    border: 1px solid var(--border-light);
    border-top: none;
    padding: 0.75rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.tab-header-bar .form-control,
.tab-header-bar .form-select {
    border-radius: 8px;
    border: 1px solid var(--border-light);
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    transition: all 0.2s ease;
}

.tab-header-bar .form-control:focus,
.tab-header-bar .form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1);
}

/* ---------- Contenedor de tabla ---------- */
.table-container {
    background: white;
    border-radius: 0 0 var(--radius-table) var(--radius-table);
    border: 1px solid var(--border-light);
    border-top: none;
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
}

.table {
    margin-bottom: 0;
    font-size: 0.85rem;
}

.table thead th {
    background: var(--gray-bg);
    color: var(--primary-dark);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border-bottom: 2px solid var(--primary-dark);
    padding: 0.9rem 0.75rem;
    white-space: nowrap;
}

.table tbody td {
    vertical-align: middle;
    padding: 0.8rem 0.75rem;
    border-bottom: 1px solid var(--border-light);
}

.table-hover tbody tr:hover {
    background-color: var(--primary-lighter);
    transition: background 0.15s ease;
}

/* ---------- Badges ---------- */
.badge-activo {
    background: #dcfce7;
    color: #0f172a !important;  /* ✅ Cambiado a negro */
    border: none;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.badge-inactivo {
    background: #fee2e2;
    color: #0f172a !important;  /* ✅ Cambiado a negro */
    border: none;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.badge-activo::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
}

.badge-inactivo::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
    display: inline-block;
}

/* Badge de conteo */
.badge-count {
    background: var(--primary-dark);
    color: white;
    padding: 0.1rem 0.5rem;
    border-radius: 20px;
    font-size: 0.6rem;
    font-weight: 600;
}

/* ---------- Botones ---------- */
.btn-primary-dark {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.45rem 1.2rem;
    border-radius: 10px;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-primary-dark:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(30, 60, 114, 0.3);
    color: white;
}

.btn-primary-dark:active {
    transform: translateY(0);
}

.btn-outline-primary-dark {
    background: transparent;
    border: 1.5px solid var(--primary-dark);
    color: var(--primary-dark);
    font-weight: 500;
    padding: 0.4rem 1rem;
    border-radius: 10px;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-outline-primary-dark:hover {
    background: var(--primary-dark);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(30, 60, 114, 0.15);
}

.btn-sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    border-radius: 8px;
}

.btn-action {
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
}

.btn-action:hover {
    background: var(--primary-lighter);
    color: var(--primary-dark);
    transform: scale(1.05);
}

.btn-action.text-danger:hover {
    background: #fee2e2;
    color: var(--danger);
}

/* ---------- Modales ---------- */
.modal-content {
    border-radius: 1rem;
    border: none;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.modal-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1.25rem 1.75rem;
    border-bottom: none;
}

.modal-header .btn-close {
    filter: brightness(0) invert(1);
    opacity: 0.8;
    transition: opacity 0.2s;
}

.modal-header .btn-close:hover {
    opacity: 1;
}

.modal-title {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modal-title svg {
    stroke: white;
}

.modal-body {
    padding: 1.75rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-body::-webkit-scrollbar {
    width: 6px;
}

.modal-body::-webkit-scrollbar-track {
    background: var(--gray-bg);
    border-radius: 3px;
}

.modal-body::-webkit-scrollbar-thumb {
    background: var(--primary-dark);
    border-radius: 3px;
}

.modal-footer {
    border-top: 1px solid var(--border-light);
    padding: 1rem 1.75rem;
    background: var(--gray-bg);
}

.modal-footer .btn {
    border-radius: 10px;
    padding: 0.5rem 1.25rem;
    font-weight: 500;
    transition: all 0.3s ease;
}

.modal-footer .btn:hover {
    transform: translateY(-1px);
}

/* ---------- Formularios ---------- */
.form-label {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--primary-dark);
    margin-bottom: 0.3rem;
}

.form-control,
.form-select {
    border-radius: 10px;
    border: 1px solid var(--border-light);
    padding: 0.55rem 0.85rem;
    font-size: 0.85rem;
    transition: all 0.2s ease;
}

.form-control:focus,
.form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
}

.form-control.is-valid {
    border-color: var(--success);
    background-image: none;
}

.form-control.is-invalid {
    border-color: var(--danger);
    background-image: none;
}

/* ---------- Detalle Enriquecido ---------- */
.detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-light);
}

.detail-header h5 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.detail-item {
    padding: 0.6rem 0.8rem;
    background: var(--gray-bg);
    border-radius: 10px;
    border: 1px solid var(--border-light);
    transition: all 0.2s ease;
}

.detail-item:hover {
    background: var(--primary-lighter);
}

.detail-item .detail-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    font-weight: 600;
}

.detail-item .detail-value {
    font-weight: 500;
    color: #1a1a1a;
    font-size: 0.9rem;
    margin-top: 0.15rem;
}

.detail-section {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.detail-section-title {
    color: var(--primary-dark);
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.detail-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    margin-bottom: 0.25rem;
    background: var(--gray-bg);
    transition: all 0.2s ease;
}

.detail-list-item:hover {
    background: var(--primary-lighter);
}

.detail-list-item .item-info {
    display: flex;
    flex-direction: column;
}

.detail-list-item .item-name {
    font-weight: 500;
    color: var(--primary-dark);
    font-size: 0.85rem;
}

.detail-list-item .item-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
}

.detail-list-item .btn-item-action {
    padding: 0.2rem 0.5rem;
    font-size: 0.65rem;
    border-radius: 6px;
    background: white;
    border: 1px solid var(--border-light);
    color: var(--primary-dark);
    cursor: pointer;
    transition: all 0.2s ease;
}

.detail-list-item .btn-item-action:hover {
    background: var(--primary-dark);
    color: white;
    border-color: var(--primary-dark);
}

.detail-empty {
    text-align: center;
    padding: 1rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-style: italic;
}

.detail-actions-bar {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

/* ---------- Árbol Jerárquico ---------- */
.arbol-container {
    padding: 0.5rem;
}

.arbol-nodo {
    margin-bottom: 0.25rem;
}

.arbol-nodo-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    background: white;
    border: 1px solid var(--border-light);
}

.arbol-nodo-header:hover {
    background: var(--gray-bg);
    border-color: var(--primary-lighter);
}

/* Raíz - Institución */
.arbol-raiz > .arbol-nodo-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    color: white;
    border: none;
    font-weight: 500;
}

.arbol-raiz > .arbol-nodo-header:hover {
    background: linear-gradient(135deg, #152a50 0%, var(--primary-dark) 100%);
}

.arbol-raiz > .arbol-nodo-header .arbol-toggle,
.arbol-raiz > .arbol-nodo-header .arbol-icon svg {
    color: white;
    stroke: white;
}

.arbol-raiz > .arbol-nodo-header .arbol-nombre {
    color: white;
}

/* Rama - Departamento */
.arbol-rama > .arbol-nodo-header {
    background: var(--primary-lighter);
    border-left: 3px solid var(--primary-dark);
}

/* Rama directa de responsables */
.arbol-rama-directa > .arbol-nodo-header {
    background: #f5f5f5;
    border: 1px dashed var(--border-light);
}

/* Hoja - Responsable */
.arbol-hoja > .arbol-nodo-header {
    background: white;
    border-left: 2px solid #ddd;
}

.arbol-hoja > .arbol-nodo-header:hover {
    background: var(--gray-bg);
}

.arbol-toggle {
    font-size: 0.7rem;
    transition: transform 0.25s ease;
    color: var(--primary-dark);
    width: 18px;
    text-align: center;
    font-weight: bold;
}

.arbol-toggle.collapsed {
    transform: rotate(-90deg);
}

.arbol-icon svg {
    stroke: var(--primary-dark);
    width: 16px;
    height: 16px;
}

.arbol-nombre {
    font-weight: 500;
    color: var(--primary-dark);
    flex: 1;
    font-size: 0.85rem;
}

.arbol-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-left: 0.25rem;
}

.arbol-badge {
    font-size: 0.65rem;
    margin-left: 0.25rem;
}

.arbol-acciones {
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.arbol-nodo-header:hover .arbol-acciones {
    opacity: 1;
}

.arbol-hijos {
    margin-left: 1.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border-light);
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.2s;
    max-height: 2000px;
    opacity: 1;
}

.arbol-hijos.collapsed {
    max-height: 0;
    opacity: 0;
    padding-left: 0;
    border-left-color: transparent;
    margin-left: 0;
}

/* ---------- Loading Spinner ---------- */
.loading-spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

.spinner-icon {
    animation: spin 0.8s linear infinite;
    width: 18px;
    height: 18px;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ---------- Highlight de búsqueda ---------- */
.highlight {
    background: #fef3c7;
    padding: 0 2px;
    border-radius: 3px;
    font-weight: 600;
}

/* ---------- Toast Notifications ---------- */
@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

@keyframes slideOutRight {
    from { transform: translateX(0); opacity: 1; }
    to { transform: translateX(100%); opacity: 0; }
}

/* ---------- Wizard de pasos ---------- */
.step-circle {
    display: inline-block;
    width: 30px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    border-radius: 50%;
    background: var(--border-light);
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.8rem;
    margin-right: 6px;
    transition: all 0.3s ease;
}

.step-circle.active {
    background: var(--primary-dark);
    color: white;
    box-shadow: 0 0 0 4px rgba(30, 60, 114, 0.15);
}

.step-circle.completed {
    background: var(--success);
    color: white;
}

.step-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 0.3s ease;
}

.step-content {
    min-height: 280px;
    animation: fadeInUp 0.4s ease;
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}

.progress {
    height: 4px;
    border-radius: 4px;
    background: var(--border-light);
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light));
    transition: width 0.5s ease;
}

/* ---------- Ubicación Selects ---------- */
.ubicacion-selects {
    background: var(--gray-bg);
    border-radius: 12px;
    padding: 1rem;
    border: 1px solid var(--border-light);
    margin-top: 0.5rem;
}

.ubicacion-selects .form-select:disabled {
    background-color: var(--border-light);
    cursor: not-allowed;
    opacity: 0.7;
}

/* ---------- Tarjetas de institución en wizard ---------- */
.institucion-card {
    transition: all 0.3s ease;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid var(--border-light);
}

.institucion-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.institucion-card.active {
    border-color: var(--primary-dark) !important;
    background: var(--primary-lighter) !important;
}

.institucion-card input[type="radio"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--primary-dark);
}

/* ---------- Responsive ---------- */
@media (max-width: 992px) {
    .stats-row {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .detail-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .nav-tabs-custom .nav-link {
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
    }

    .tab-header-bar {
        flex-direction: column;
        align-items: stretch;
    }

    .tab-header-bar .d-flex {
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .modal-body {
        padding: 1.25rem;
    }

    .modal-header {
        padding: 1rem 1.25rem;
    }

    .step-label {
        font-size: 0.7rem;
    }

    .step-circle {
        width: 24px;
        height: 24px;
        line-height: 24px;
        font-size: 0.7rem;
    }

    .institucion-card .card-body {
        padding: 1.25rem;
    }
}

@media (max-width: 576px) {
    .stats-row {
        grid-template-columns: 1fr;
    }

    .table thead {
        display: none;
    }

    .table tbody td {
        display: block;
        text-align: right;
        padding-left: 50%;
        position: relative;
    }

    .table tbody td::before {
        content: attr(data-label);
        position: absolute;
        left: 0.75rem;
        width: 45%;
        text-align: left;
        font-weight: 600;
        color: var(--primary-dark);
        font-size: 0.7rem;
    }

    .table tbody tr {
        margin-bottom: 1rem;
        display: block;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 0.5rem 0;
        background: white;
    }

    .table tbody td:last-child {
        border-bottom: none;
    }

    .arbol-hijos {
        margin-left: 0.75rem;
        padding-left: 0.5rem;
    }

    .arbol-nodo-header {
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .arbol-acciones {
        opacity: 1;
        margin-left: auto;
    }

    .detail-grid {
        grid-template-columns: 1fr;
    }

    .modal-footer {
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .modal-footer .btn {
        flex: 1;
        min-width: 80px;
    }
}
</file>

<file path="resources/css/admin-equipos.css">
/* ============================================
   ADMIN EQUIPOS - Catálogo de Equipos
   ============================================ */

/* ==================== VARIABLES ==================== */
:root {
    --primary-dark: #1e3c72;
    --primary-light: #2a4a8a;
    --primary-lighter: #eef3fc;
    --success: #1e7e34;
    --danger: #c5221f;
    --warning: #f6c23e;
    --gray-bg: #f8f9fc;
    --border-light: #e9ecef;
    --text-muted: #6c757d;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.12);
    --radius-card: 1rem;
    --radius-table: 0.75rem;
}

/* ==================== ESTADÍSTICAS ==================== */
.stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
}

.stat-card-mini {
    background: white;
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.stat-card-mini::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    background: rgba(30, 60, 114, 0.03);
    border-radius: 50%;
    transform: translate(30%, -30%);
}

.stat-card-mini:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary-lighter);
}

.stat-info {
    position: relative;
    z-index: 1;
}

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1.2;
}

.stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
}

.stat-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-lighter);
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
}

.stat-card-mini:hover .stat-icon-circle {
    background: var(--primary-dark);
    transform: scale(1.05) rotate(-5deg);
}

.stat-card-mini:hover .stat-icon-circle svg {
    stroke: white;
}

.stat-icon-circle svg {
    stroke: var(--primary-dark);
    transition: stroke 0.3s ease;
}

/* ==================== TABS PERSONALIZADOS ==================== */
.nav-tabs-custom {
    display: flex;
    gap: 0.25rem;
    border-bottom: 2px solid var(--border-light);
    margin-bottom: 0;
    background: white;
    padding: 0 0.5rem;
    border-radius: var(--radius-table) var(--radius-table) 0 0;
}

.nav-tabs-custom .nav-item {
    margin-bottom: -2px;
}

.nav-tabs-custom .nav-link {
    border: none;
    padding: 0.85rem 1.5rem;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 0;
    background: transparent;
    transition: all 0.3s ease;
    position: relative;
}

.nav-tabs-custom .nav-link .tab-icon {
    font-size: 18px;
}

.nav-tabs-custom .nav-link .tab-badge {
    background: var(--primary-lighter);
    color: var(--primary-dark);
    padding: 0.1rem 0.5rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 600;
    margin-left: 4px;
}

.nav-tabs-custom .nav-link:hover {
    color: var(--primary-dark);
    background: var(--primary-lighter);
}

.nav-tabs-custom .nav-link.active {
    color: var(--primary-dark);
    font-weight: 600;
    background: transparent;
}

.nav-tabs-custom .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-dark), var(--primary-light));
    border-radius: 3px 3px 0 0;
}

.nav-tabs-custom .nav-link.active .tab-badge {
    background: var(--primary-dark);
    color: white;
}

/* ==================== FILTROS ==================== */
.filters-bar {
    background: white;
    border: 1px solid var(--border-light);
    border-top: none;
    padding: 0.75rem 1.25rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
}

.filters-bar .form-control,
.filters-bar .form-select {
    border-radius: 8px;
    border: 1px solid var(--border-light);
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    transition: all 0.2s ease;
    background: white;
}

.filters-bar .form-control:focus,
.filters-bar .form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1);
}

.filters-bar .input-group .input-group-text {
    background: white;
    border-right: none;
    color: var(--text-muted);
}

.filters-bar .input-group .form-control {
    border-left: none;
}

/* ==================== BOTONES ==================== */
.btn-primary-dark {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.45rem 1.2rem;
    border-radius: 10px;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-primary-dark:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(30, 60, 114, 0.3);
    color: white;
}

.btn-primary-dark:active {
    transform: translateY(0);
}

.btn-outline-primary-dark {
    background: transparent;
    border: 1.5px solid var(--primary-dark);
    color: var(--primary-dark);
    font-weight: 500;
    padding: 0.4rem 1rem;
    border-radius: 10px;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-outline-primary-dark:hover {
    background: var(--primary-dark);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(30, 60, 114, 0.15);
}

.btn-outline-danger {
    border: 1.5px solid var(--danger);
    color: var(--danger);
    background: transparent;
    transition: all 0.2s ease;
}

.btn-outline-danger:hover {
    background: var(--danger);
    color: white;
    transform: translateY(-2px);
}

.btn-sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    border-radius: 8px;
}

.btn-action {
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
}

.btn-action:hover {
    background: var(--primary-lighter);
    color: var(--primary-dark);
    transform: scale(1.05);
}

.btn-action.text-danger:hover {
    background: #fee2e2;
    color: var(--danger);
}

/* ==================== TABLAS ==================== */
.table-container {
    background: white;
    border-radius: 0 0 var(--radius-table) var(--radius-table);
    border: 1px solid var(--border-light);
    border-top: none;
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
}

.table {
    margin-bottom: 0;
    font-size: 0.85rem;
}

.table th {
    background: var(--gray-bg);
    color: var(--primary-dark);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border-bottom: 2px solid var(--primary-dark);
    padding: 0.9rem 0.75rem;
    white-space: nowrap;
}

.table td {
    padding: 0.8rem 0.75rem;
    vertical-align: middle;
    border-bottom: 1px solid var(--border-light);
    font-size: 0.85rem;
}

.table tbody tr:hover {
    background-color: var(--primary-lighter);
    transition: background 0.15s ease;
}

/* ==================== BADGES ==================== */
.badge-activo {
    background: #dcfce7;
    color: #0f172a !important;
    border: none;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.badge-inactivo {
    background: #fee2e2;
    color: #0f172a !important;
    border: none;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.badge-activo::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
}

.badge-inactivo::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
    display: inline-block;
}

.badge-info {
    background: var(--primary-lighter) !important;
    color: var(--primary-dark) !important;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
}

/* ==================== MODALES ==================== */
.modal-content {
    border-radius: 1rem;
    border: none;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.modal-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1.25rem 1.75rem;
    border-bottom: none;
}

.modal-header .btn-close {
    filter: brightness(0) invert(1);
    opacity: 0.8;
    transition: opacity 0.2s;
}

.modal-header .btn-close:hover {
    opacity: 1;
}

.modal-title {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modal-title svg {
    stroke: white;
}

.modal-body {
    padding: 1.75rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-body::-webkit-scrollbar {
    width: 6px;
}

.modal-body::-webkit-scrollbar-track {
    background: var(--gray-bg);
    border-radius: 3px;
}

.modal-body::-webkit-scrollbar-thumb {
    background: var(--primary-dark);
    border-radius: 3px;
}

.modal-footer {
    border-top: 1px solid var(--border-light);
    padding: 1rem 1.75rem;
    background: var(--gray-bg);
}

.modal-footer .btn {
    border-radius: 10px;
    padding: 0.5rem 1.25rem;
    font-weight: 500;
    transition: all 0.3s ease;
}

.modal-footer .btn:hover {
    transform: translateY(-1px);
}

/* ==================== FORMULARIOS ==================== */
.form-label {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--primary-dark);
    margin-bottom: 0.3rem;
}

.form-control,
.form-select {
    border-radius: 10px;
    border: 1px solid var(--border-light);
    padding: 0.55rem 0.85rem;
    font-size: 0.85rem;
    transition: all 0.2s ease;
}

.form-control:focus,
.form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
}

textarea.form-control {
    resize: vertical;
}

/* ==================== DETALLE MODAL ==================== */
.detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-light);
}

.detail-header h5 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary-dark);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.detail-item {
    padding: 0.6rem 0.8rem;
    background: var(--gray-bg);
    border-radius: 10px;
    border: 1px solid var(--border-light);
    transition: all 0.2s ease;
}

.detail-item:hover {
    background: var(--primary-lighter);
}

.detail-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    font-weight: 600;
}

.detail-value {
    font-weight: 500;
    color: #1a1a1a;
    font-size: 0.9rem;
    margin-top: 0.15rem;
}

.detail-section {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.detail-section-title {
    color: var(--primary-dark);
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.detail-chip {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    background: var(--gray-bg);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--primary-dark);
    transition: all 0.2s ease;
}

.detail-chip:hover {
    border-color: var(--primary-dark);
    box-shadow: 0 2px 8px rgba(30, 60, 114, 0.1);
}

.detail-chip small {
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-top: 2px;
}

.detail-empty {
    text-align: center;
    padding: 1rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-style: italic;
}

.detail-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-light);
}

.detail-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--gray-bg);
    border-bottom: 1px solid var(--border-light);
}

.detail-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary-dark), var(--primary-light));
}

.detail-card-body {
    padding: 1.25rem;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border-light);
}

.detail-row:last-child {
    border-bottom: none;
}

.detail-card-footer {
    padding: 1rem 1.25rem;
    background: var(--gray-bg);
    border-top: 1px solid var(--border-light);
}

.detail-actions-bar {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

/* ==================== ÁRBOL DE EQUIPOS ==================== */
.arbol-contenedor {
    background: white;
    border-radius: 0 0 var(--radius-table) var(--radius-table);
    padding: 1.25rem;
    border: 1px solid var(--border-light);
    border-top: none;
    min-height: 400px;
}

.arbol-container {
    font-family: inherit;
}

.arbol-nodo {
    margin-bottom: 0.25rem;
}

.arbol-raiz {
    border: 1px solid var(--border-light);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 0.5rem;
}

.arbol-rama {
    margin-left: 1.5rem;
    margin-top: 0.25rem;
    border-left: 2px solid var(--border-light);
    padding-left: 0.75rem;
}

.arbol-rama-directa {
    margin-left: 1.5rem;
    margin-top: 0.25rem;
    border-left: 2px solid var(--primary-dark);
    padding-left: 0.75rem;
}

.arbol-hoja {
    margin-left: 1.5rem;
    margin-top: 0.25rem;
}

.arbol-nodo-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: var(--gray-bg);
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 8px;
    flex-wrap: wrap;
}

.arbol-nodo-header:hover {
    background: var(--primary-lighter);
}

/* Raíz - Marca */
.arbol-raiz > .arbol-nodo-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    color: white;
    border: none;
    font-weight: 500;
}

.arbol-raiz > .arbol-nodo-header:hover {
    background: linear-gradient(135deg, #152a50 0%, var(--primary-dark) 100%);
}

.arbol-raiz > .arbol-nodo-header .arbol-toggle,
.arbol-raiz > .arbol-nodo-header .arbol-icon svg {
    color: white;
    stroke: white;
}

.arbol-raiz > .arbol-nodo-header .arbol-nombre {
    color: white;
}

.arbol-raiz > .arbol-nodo-header .arbol-badge {
    background: rgba(255, 255, 255, 0.2);
    color: white;
}

.arbol-toggle {
    font-size: 0.7rem;
    transition: transform 0.25s ease;
    color: var(--primary-dark);
    width: 18px;
    text-align: center;
    font-weight: bold;
}

.arbol-toggle.collapsed {
    transform: rotate(-90deg);
}

.arbol-icon svg {
    stroke: var(--primary-dark);
    width: 16px;
    height: 16px;
}

.arbol-nombre {
    font-weight: 500;
    color: var(--primary-dark);
    flex: 1;
    font-size: 0.85rem;
}

.arbol-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-left: 0.25rem;
}

.arbol-badge {
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 600;
    background: var(--primary-lighter);
    color: var(--primary-dark);
}

.arbol-acciones {
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.arbol-nodo-header:hover .arbol-acciones {
    opacity: 1;
}

.arbol-hijos {
    margin-left: 0.75rem;
    padding: 0.5rem 0 0.5rem 0.75rem;
    border-left: 2px solid var(--border-light);
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.25s ease, padding 0.2s;
    max-height: 2000px;
    opacity: 1;
}

.arbol-hijos.collapsed {
    max-height: 0;
    opacity: 0;
    padding-left: 0;
    border-left-color: transparent;
    margin-left: 0;
}

/* ==================== LOADING SPINNER ==================== */
.loading-spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 2rem;
    color: var(--text-muted);
    font-size: 0.85rem;
}

.spinner-icon {
    animation: spin 0.8s linear infinite;
    width: 18px;
    height: 18px;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ==================== HIGHLIGHT ==================== */
.highlight {
    background: #fef3c7;
    padding: 0 2px;
    border-radius: 3px;
    font-weight: 600;
}

/* ==================== PAGINACIÓN ==================== */
.pagination-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.pagination-info {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.pagination-btns {
    display: flex;
    gap: 4px;
}

.pagination-btn {
    width: 34px;
    height: 34px;
    border: 1px solid var(--border-light);
    background: white;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--primary-dark);
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.pagination-btn:hover:not(.disabled):not(.active) {
    background: var(--primary-dark);
    color: white;
    border-color: var(--primary-dark);
}

.pagination-btn.active {
    background: var(--primary-dark);
    color: white;
    border-color: var(--primary-dark);
    font-weight: 600;
}

.pagination-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.pagination-ellipsis {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
}

/* ==================== RESPONSIVE ==================== */
@media (max-width: 992px) {
    .stats-row {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .detail-grid {
        grid-template-columns: 1fr;
    }

    .filters-bar {
        flex-direction: column;
        align-items: stretch;
    }

    .filters-bar .form-control,
    .filters-bar .form-select,
    .filters-bar .btn {
        width: 100%;
    }
}

@media (max-width: 768px) {
    .nav-tabs-custom {
        flex-wrap: wrap;
        padding: 0 0.5rem;
    }

    .nav-tabs-custom .nav-link {
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
    }

    .table-container {
        overflow-x: auto;
    }

    .table {
        min-width: 600px;
    }

    .detail-grid {
        grid-template-columns: 1fr;
    }

    .arbol-rama,
    .arbol-rama-directa,
    .arbol-hoja {
        margin-left: 0.75rem;
    }

    .modal-body {
        padding: 1.25rem;
    }

    .modal-header {
        padding: 1rem 1.25rem;
    }

    .detail-card-header {
        flex-wrap: wrap;
    }
}

@media (max-width: 576px) {
    .stats-row {
        grid-template-columns: 1fr;
    }

    .stat-number {
        font-size: 1.5rem;
    }

    .table thead {
        display: none;
    }

    .table tbody td {
        display: block;
        text-align: right;
        padding-left: 50%;
        position: relative;
    }

    .table tbody td::before {
        content: attr(data-label);
        position: absolute;
        left: 0.75rem;
        width: 45%;
        text-align: left;
        font-weight: 600;
        color: var(--primary-dark);
        font-size: 0.7rem;
    }

    .table tbody tr {
        margin-bottom: 1rem;
        display: block;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 0.5rem 0;
        background: white;
    }

    .table tbody td:last-child {
        border-bottom: none;
    }

    .arbol-nodo-header {
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .arbol-acciones {
        opacity: 1;
        margin-left: auto;
    }

    .modal-footer {
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .modal-footer .btn {
        flex: 1;
        min-width: 80px;
    }

    .detail-card-header {
        flex-direction: column;
        text-align: center;
    }

    .pagination-bar {
        flex-direction: column;
        align-items: center;
    }
}

/* ==================== UTILIDADES ==================== */
.text-muted {
    color: var(--text-muted) !important;
}

.text-danger {
    color: var(--danger) !important;
}

.text-success {
    color: var(--success) !important;
}

.fw-medium {
    font-weight: 500;
}

.fw-bold {
    font-weight: 700;
}

.fw-semibold {
    font-weight: 600;
}

.gap-1 { gap: 4px; }
.gap-2 { gap: 8px; }
.ms-1 { margin-left: 4px; }
.ms-2 { margin-left: 8px; }
.me-1 { margin-right: 4px; }
.me-2 { margin-right: 8px; }
.mt-1 { margin-top: 4px; }
.mt-2 { margin-top: 8px; }
.mt-3 { margin-top: 16px; }
.mb-0 { margin-bottom: 0; }
.mb-2 { margin-bottom: 8px; }
.mb-3 { margin-bottom: 16px; }
.mb-4 { margin-bottom: 24px; }
.px-4 { padding-left: 24px; padding-right: 24px; }
.py-4 { padding-top: 24px; padding-bottom: 24px; }
.text-center { text-align: center; }
.text-end { text-align: right; }
.flex-grow-1 { flex-grow: 1; }
.w-100 { width: 100%; }

.bg-primary-dark {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
}

.modal-header.bg-primary-dark .btn-close {
    filter: brightness(0) invert(1);
}

/* Animación slideIn para toasts */
@keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}
