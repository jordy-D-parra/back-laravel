                    $camposFormateados[] = [
                        'campo' => $campo,
                        'etiqueta' => $etiquetasCampos[$campo],
                        'valor_original' => null,
                        'valor_nuevo' => $this->formatearValor($valor),
                        'cambio' => false
                    ];
                }
            }
        }

        // Obtener la acción legible
        $accionesLegibles = [
