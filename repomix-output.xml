/* ============================================================
   19. SCROLLBAR PERSONALIZADA
   ============================================================ */
.modal-body::-webkit-scrollbar {
    width: 6px;
}

.modal-body::-webkit-scrollbar-track {
    background: var(--gray-bg);
    border-radius: 3px;
}

.modal-body::-webkit-scrollbar-thumb {
    background: var(--primary-dark);
    border-radius: 3px;
}

.modal-body::-webkit-scrollbar-thumb:hover {
    background: var(--primary-light);
}

#itemsContainer::-webkit-scrollbar {
    width: 4px;
}

#itemsContainer::-webkit-scrollbar-track {
    background: var(--gray-bg);
    border-radius: 2px;
}

#itemsContainer::-webkit-scrollbar-thumb {
    background: var(--primary-dark);
    border-radius: 2px;
}

/* ============================================================
   20. ESTILOS PARA FILTROS
   ============================================================ */
.filters-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    background: #fff;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.filters-bar .form-control,
.filters-bar .form-select {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    transition: all var(--transition-speed) ease;
}

.filters-bar .form-control:focus,
.filters-bar .form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 0.2rem rgba(30, 60, 114, 0.15);
}

/* ============================================================
   TIMELINE VISUAL PARA PRÉSTAMOS
   ============================================================ */
.prestamo-timeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.5rem 0;
    position: relative;
    margin: 1rem 0;
}

.prestamo-timeline::before {
    content: '';
    position: absolute;
    top: 2.2rem;
    left: 2.5%;
    right: 2.5%;
    height: 3px;
    background: #e9ecef;
    z-index: 0;
}

.prestamo-timeline .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    position: relative;
    z-index: 1;
}

.prestamo-timeline .step .step-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    background: #f8f9fc;
    border: 3px solid #dee2e6;
    transition: all 0.3s ease;
    position: relative;
}

.prestamo-timeline .step .step-icon .step-number {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #dee2e6;
    color: #495057;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    font-size: 0.55rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

.prestamo-timeline .step .step-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-align: center;
    margin-top: 0.5rem;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.prestamo-timeline .step .step-date {
    font-size: 0.6rem;
    color: #adb5bd;
    text-align: center;
}

/* Estados del timeline */
.prestamo-timeline .step.completed .step-icon {
    background: #d4edda;
    border-color: #28a745;
    color: #155724;
}

.prestamo-timeline .step.completed .step-icon .step-number {
    background: #28a745;
    color: #fff;
}

.prestamo-timeline .step.completed .step-label {
    color: #28a745;
}

.prestamo-timeline .step.active .step-icon {
    background: #cce5ff;
    border-color: #1e3c72;
    color: #1e3c72;
    transform: scale(1.1);
    box-shadow: 0 0 0 4px rgba(30, 60, 114, 0.15);
}

.prestamo-timeline .step.active .step-icon .step-number {
    background: #1e3c72;
    color: #fff;
}

.prestamo-timeline .step.active .step-label {
    color: #1e3c72;
    font-weight: 700;
}

.prestamo-timeline .step.pending .step-icon {
    background: #f8f9fc;
    border-color: #dee2e6;
    color: #adb5bd;
}

.prestamo-timeline .step.pending .step-label {
    color: #adb5bd;
}

.prestamo-timeline .step.rejected .step-icon {
    background: #f8d7da;
    border-color: #dc3545;
    color: #721c24;
}

.prestamo-timeline .step.rejected .step-label {
    color: #dc3545;
}

.prestamo-timeline .step.overdue .step-icon {
    background: #f8d7da;
    border-color: #dc3545;
    color: #721c24;
    animation: pulse-overdue 1.5s infinite;
}

.prestamo-timeline .step.overdue .step-label {
    color: #dc3545;
}

@keyframes pulse-overdue {
    0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
    100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
}

/* ============================================================
   MEJORAS EN MODALES DE DEVOLUCIÓN Y EXTENSIÓN
   ============================================================ */
.items-list-container {
    max-height: 300px;
    overflow-y: auto;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 0.5rem;
}

.items-list-container .item-checkbox {
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.2s ease;
}

.items-list-container .item-checkbox:hover {
    background: #f8f9fc;
}

.items-list-container .item-checkbox:last-child {
    border-bottom: none;
}

.items-list-container .item-checkbox .item-info {
    flex: 1;
    margin-left: 0.75rem;
}

.items-list-container .item-checkbox .item-info .item-name {
    font-weight: 500;
    color: #1e3c72;
    font-size: 0.85rem;
}

.items-list-container .item-checkbox .item-info .item-detail {
    font-size: 0.7rem;
    color: #6c757d;
}

.items-list-container .item-checkbox .item-badge-estado {
    font-size: 0.6rem;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 600;
}

.items-list-container .item-checkbox .item-badge-estado.entregado {
    background: #cce5ff;
    color: #004085;
}

.items-list-container .item-checkbox .item-badge-estado.pendiente {
    background: #fff3cd;
    color: #856404;
}

.items-list-container .item-checkbox .item-badge-estado.devuelto {
    background: #d4edda;
    color: #155724;
}

.items-list-container .item-checkbox .item-badge-estado.dañado {
    background: #f8d7da;
    color: #721c24;
}

.estado-devolucion-select {
    margin-top: 0.5rem;
    margin-left: 2.3rem;
    font-size: 0.8rem;
}

.estado-devolucion-select select {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    font-size: 0.8rem;
}

.estado-devolucion-select select:focus {
    border-color: #1e3c72;
    outline: none;
}

/* ============================================================
   RESPONSIVE TIMELINE
   ============================================================ */
@media (max-width: 768px) {
    .prestamo-timeline {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 1rem 0;
    }

    .prestamo-timeline::before {
        display: none;
    }

    .prestamo-timeline .step {
        flex-direction: row;
        width: 100%;
        gap: 1rem;
        padding: 0.5rem 0;
        border-left: 3px solid #dee2e6;
        padding-left: 1rem;
    }

    .prestamo-timeline .step.completed {
        border-left-color: #28a745;
    }

    .prestamo-timeline .step.active {
        border-left-color: #1e3c72;
    }

    .prestamo-timeline .step.pending {
        border-left-color: #dee2e6;
    }

    .prestamo-timeline .step.rejected,
    .prestamo-timeline .step.overdue {
        border-left-color: #dc3545;
    }

    .prestamo-timeline .step .step-icon {
        width: 32px;
        height: 32px;
        font-size: 0.9rem;
    }

    .prestamo-timeline .step .step-icon .step-number {
        width: 16px;
        height: 16px;
        font-size: 0.45rem;
        top: -6px;
        right: -6px;
    }

    .prestamo-timeline .step .step-label {
        font-size: 0.65rem;
        margin-top: 0;
        text-align: left;
    }

    .prestamo-timeline .step .step-date {
        font-size: 0.55rem;
        margin-left: auto;
    }
}

/* ============================================================
   ESTILOS UNIFICADOS - AGREGAR AL FINAL DEL ARCHIVO
   ============================================================ */

/* ---------- HEADER CON GRADIENTE ---------- */
.page-header {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
