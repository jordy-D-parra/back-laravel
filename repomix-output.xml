    --text-muted: #6c757d;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --radius-card: 1rem;
    --radius-table: 0.75rem;
}

/* ---------- HEADER CON GRADIENTE ---------- */
.page-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    margin-bottom: 1.5rem;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.page-header h4 {
    color: white;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.page-header p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    margin: 0;
}

/* ---------- TARJETAS DE ESTADÍSTICAS ---------- */
.stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
}

.stat-card-mini {
    background: white;
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.stat-card-mini::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    background: rgba(30, 60, 114, 0.03);
    border-radius: 50%;
    transform: translate(30%, -30%);
}

.stat-card-mini:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-lighter);
}

.stat-card-mini .stat-info {
    position: relative;
    z-index: 1;
}

.stat-card-mini .stat-info .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-dark);
    line-height: 1.2;
}

.stat-card-mini .stat-info .stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
}

.stat-card-mini .stat-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-lighter);
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
}

.stat-card-mini:hover .stat-icon-circle {
    background: var(--primary-dark);
    transform: scale(1.05) rotate(-5deg);
}

.stat-card-mini:hover .stat-icon-circle svg {
    stroke: white;
}

.stat-card-mini .stat-icon-circle svg {
    stroke: var(--primary-dark);
    transition: stroke 0.3s ease;
}

/* ---------- BARRA DE FILTROS CON SEPARACIÓN ---------- */
.filters-bar {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 1rem !important;
    flex-wrap: wrap !important;
    background: white;
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
}

.filters-bar .filtro-busqueda {
    flex: 1 !important;
    min-width: 200px !important;
    max-width: 450px !important;
}

.filters-bar .filtro-busqueda .input-group-text {
    background: white;
    border-right: none;
    color: var(--text-muted);
}

.filters-bar .filtro-busqueda .form-control {
    border-left: none;
    font-size: 0.85rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0 8px 8px 0;
}

.filters-bar .filtro-busqueda .form-control:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1);
}

.filters-bar .btn-accion {
    flex-shrink: 0 !important;
}

@media (max-width: 576px) {
    .filters-bar {
        flex-direction: column !important;
        align-items: stretch !important;
    }
    
    .filters-bar .filtro-busqueda {
        max-width: 100% !important;
        min-width: unset !important;
    }
    
    .filters-bar .btn-accion {
        width: 100% !important;
        justify-content: center !important;
    }
}

/* ---------- BOTONES ---------- */
.btn-primary-dark {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    border: none;
    color: white;
    font-weight: 500;
    padding: 0.45rem 1.2rem;
    border-radius: 10px;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-primary-dark:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(30, 60, 114, 0.3);
    color: white;
}

.btn-primary-dark:active {
    transform: translateY(0);
}

.btn-outline-primary-dark {
    background: transparent;
    border: 1.5px solid var(--primary-dark);
    color: var(--primary-dark);
    font-weight: 500;
    padding: 0.4rem 1rem;
    border-radius: 10px;
    font-size: 0.8rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.btn-outline-primary-dark:hover {
    background: var(--primary-dark);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(30, 60, 114, 0.15);
}

.btn-outline-danger {
    background: transparent;
    border: 1.5px solid var(--danger);
    color: var(--danger);
    transition: all 0.2s ease;
}

.btn-outline-danger:hover {
    background: var(--danger);
    color: white;
    transform: translateY(-2px);
}

.btn-sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    border-radius: 8px;
}

.btn-action {
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
}

.btn-action:hover {
    background: var(--primary-lighter);
    color: var(--primary-dark);
    transform: scale(1.05);
}

.btn-action.text-danger:hover {
    background: #fee2e2;
    color: var(--danger);
}

/* ---------- TABLA ---------- */
.table-container {
    background: white;
    border-radius: var(--radius-table);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    overflow: hidden;
}

.table {
    margin-bottom: 0;
    font-size: 0.85rem;
}

.table thead th {
    background: var(--gray-bg);
    color: var(--primary-dark);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    border-bottom: 2px solid var(--primary-dark);
    padding: 0.9rem 0.75rem;
    white-space: nowrap;
}

.table tbody td {
    vertical-align: middle;
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--border-light);
}

.table-hover tbody tr:hover {
    background-color: var(--primary-lighter);
    transition: background 0.15s ease;
}

/* ---------- BADGES ---------- */
.badge-usuario-si {
    background: transparent;
    color: var(--success);
    border: 1px solid var(--success);
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
}

.badge-usuario-no {
    background: transparent;
    color: var(--danger);
    border: 1px solid var(--danger);
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
}

/* ---------- MODALES ---------- */
.modal-content {
    border-radius: 1rem;
    border: none;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.modal-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1.25rem 1.75rem;
    border-bottom: none;
}

.modal-header .btn-close {
    filter: brightness(0) invert(1);
    opacity: 0.8;
    transition: opacity 0.2s;
}

.modal-header .btn-close:hover {
    opacity: 1;
}

.modal-title {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modal-title svg {
    stroke: white;
}

.modal-body {
    padding: 1.75rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-body::-webkit-scrollbar {
    width: 6px;
}

.modal-body::-webkit-scrollbar-track {
    background: var(--gray-bg);
    border-radius: 3px;
}

.modal-body::-webkit-scrollbar-thumb {
    background: var(--primary-dark);
    border-radius: 3px;
}

.modal-footer {
    border-top: 1px solid var(--border-light);
    padding: 1rem 1.75rem;
    background: var(--gray-bg);
}

.modal-footer .btn {
    border-radius: 10px;
    padding: 0.5rem 1.25rem;
    font-weight: 500;
    transition: all 0.3s ease;
}

.modal-footer .btn:hover {
    transform: translateY(-1px);
}

/* ---------- FORMULARIOS ---------- */
.form-label {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--primary-dark);
    margin-bottom: 0.3rem;
}

.form-control,
.form-select {
    border-radius: 10px;
    border: 1px solid var(--border-light);
    padding: 0.55rem 0.85rem;
    font-size: 0.85rem;
    transition: all 0.2s ease;
}

.form-control:focus,
.form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
}

/* ---------- DETALLE ---------- */
.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
}

.detail-item {
    padding: 0.6rem 0.8rem;
