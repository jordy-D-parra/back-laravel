}

.detail-item .detail-value {
    font-weight: 500;
    color: #1a1a1a;
    font-size: 0.9rem;
    margin-top: 0.15rem;
}

/* ---------- ELIMINACIÓN ---------- */
.delete-warning {
    background: #fff3f3;
    border: 1px solid #f5c6cb;
    border-radius: 10px;
    padding: 1rem;
    margin-bottom: 1rem;
}

/* ---------- PAGINACIÓN ---------- */
.pagination {
    margin-bottom: 0;
}

.pagination .page-link {
