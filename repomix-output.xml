.split-left-image {
    flex: 1;
    position: relative;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
}

.split-left-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(25, 42, 86, 0.85) 0%, rgba(35, 58, 118, 0.75) 100%);
}

.left-content {
    position: relative;
