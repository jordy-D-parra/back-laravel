}

/* ---------- MODALES ---------- */
.modal-content {
    border-radius: 1rem;
    border: none;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
}

.modal-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    color: white;
    padding: 1.25rem 1.75rem;
    border-bottom: none;
}

.modal-header .btn-close {
    filter: brightness(0) invert(1);
    opacity: 0.8;
    transition: opacity 0.2s;
}

.modal-header .btn-close:hover {
    opacity: 1;
}

.modal-header.bg-danger {
    background: linear-gradient(135deg, var(--danger) 0%, #a71d2a 100%) !important;
}

.modal-title {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.modal-title svg {
    stroke: white;
}

.modal-body {
    padding: 1.75rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-body::-webkit-scrollbar {
    width: 6px;
}

.modal-body::-webkit-scrollbar-track {
    background: var(--gray-bg);
    border-radius: 3px;
}

.modal-body::-webkit-scrollbar-thumb {
    background: var(--primary-dark);
    border-radius: 3px;
}

.modal-footer {
    border-top: 1px solid var(--border-light);
    padding: 1rem 1.75rem;
    background: var(--gray-bg);
}

.modal-footer .btn {
    border-radius: 10px;
    padding: 0.5rem 1.25rem;
    font-weight: 500;
    transition: all 0.3s ease;
}

.modal-footer .btn:hover {
    transform: translateY(-1px);
}

/* ---------- FORMULARIOS ---------- */
.form-label {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--primary-dark);
    margin-bottom: 0.3rem;
}

.form-control,
.form-select {
    border-radius: 10px;
    border: 1px solid var(--border-light);
    padding: 0.55rem 0.85rem;
    font-size: 0.85rem;
    transition: all 0.2s ease;
}

.form-control:focus,
.form-select:focus {
    border-color: var(--primary-dark);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
}

/* ---------- ITEMS CARD ---------- */
.item-card {
    background: var(--gray-bg);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    transition: all 0.2s ease;
}

.item-card:hover {
    border-color: var(--primary-dark);
    box-shadow: 0 2px 8px rgba(30, 60, 114, 0.08);
}

/* ---------- RESPONSABLE DISPLAY ---------- */
.responsable-display {
    background: var(--gray-bg);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 0.75rem;
    min-height: 50px;
    font-size: 0.85rem;
}

.responsable-display .resp-nombre {
    color: var(--primary-dark);
    font-weight: 600;
}

.responsable-display .resp-info {
    color: var(--text-muted);
    font-size: 0.75rem;
}

/* ---------- SKELETON LOADING ---------- */
.skeleton-row {
    height: 50px;
    margin-bottom: 8px;
    border-radius: 6px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
}

@keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

/* ---------- PAGINACIÓN ---------- */
.pagination {
    margin-bottom: 0;
}

.pagination .page-link {
    color: var(--primary-dark);
    border-radius: 8px;
    margin: 0 2px;
    border: 1px solid var(--border-light);
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
}

.pagination .page-link:hover {
    background: var(--primary-lighter);
    border-color: var(--primary-dark);
}

.pagination .page-item.active .page-link {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
    color: white;
}

.pagination .page-item.disabled .page-link {
    color: var(--text-muted);
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 992px) {
    .stats-row {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }
}

@media (max-width: 768px) {
    .page-header {
        flex-direction: column;
        text-align: center;
    }

    .modal-body {
        padding: 1rem;
    }

    .item-card .row {
        flex-direction: column;
        gap: 0.5rem;
    }
}

@media (max-width: 576px) {
    .stats-row {
        grid-template-columns: 1fr;
    }

    .table thead {
        display: none;
    }

    .table tbody td {
        display: block;
        text-align: right;
        padding-left: 50%;
        position: relative;
    }

    .table tbody td::before {
        content: attr(data-label);
        position: absolute;
        left: 0.75rem;
        width: 45%;
        text-align: left;
        font-weight: 600;
        color: var(--primary-dark);
        font-size: 0.7rem;
    }

    .table tbody tr {
        margin-bottom: 1rem;
        display: block;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 0.5rem 0;
        background: white;
    }

    .table tbody td:last-child {
        border-bottom: none;
    }

    .btn-group {
        justify-content: flex-end;
    }
}
