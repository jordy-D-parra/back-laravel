<file path="resources/css/admin-roles.css">
/* ============================================================
   ADMIN ROLES - Estilos unificados con el sistema
   ============================================================ */

/* ---------- Variables ---------- */
:root {
    --primary-dark: #1e3c72;
    --primary-light: #2a4a8a;
    --primary-lighter: #eef3fc;
    --success: #1e7e34;
    --danger: #c5221f;
    --warning: #f6c23e;
    --gray-bg: #f8f9fc;
    --border-light: #e9ecef;
    --text-muted: #6c757d;
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
    --radius-card: 1rem;
    --radius-table: 0.75rem;
}

/* ---------- HEADER CON GRADIENTE ---------- */
.page-header {
    background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
    border-radius: 16px;
    padding: 1.5rem 2rem;
    margin-bottom: 1.5rem;
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.page-header h4 {
    color: white;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.page-header p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    margin: 0;
}

/* ---------- TARJETAS DE ESTADÍSTICAS ---------- */
.stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
}

.stat-card-mini {
    background: white;
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
