    align-items: center;
    gap: 0.75rem;
}

.modal-title svg {
    stroke: white;
}

.modal-body {
    padding: 1.75rem;
    max-height: 70vh;
    overflow-y: auto;
}

.modal-body::-webkit-scrollbar {
    width: 6px;
