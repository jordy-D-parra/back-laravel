/* ---------- TAB HEADER BAR CON BÚSQUEDA ---------- */
.tab-header-bar .filtro-busqueda {
    flex: 1;
    min-width: 200px;
    max-width: 350px;
}

.tab-header-bar .filtro-busqueda .input-group-text {
    background: white;
