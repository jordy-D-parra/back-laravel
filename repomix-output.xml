            'logout' => ['icono' => '🔒', 'color' => '#6c757d', 'texto' => 'Cierre de Sesión'],
            'login_fallido' => ['icono' => '⚠️', 'color' => '#dc3545', 'texto' => 'Intento Fallido'],
        ];

        $accionInfo = $accionesLegibles[$auditorium->accion] ?? [
