.badge-prioridad-baja {
    background: #e9ecef;
    color: #6c757d;
}

.badge-prioridad-normal {
    background: #d4edda;
    color: #155724;
}

.badge-prioridad-alta {
    background: #fff3cd;
    color: #856404;
}

.badge-prioridad-urgente {
