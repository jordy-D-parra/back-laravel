    border-radius: 8px;
}

.btn-action {
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
}

.btn-action:hover {
    background: var(--primary-lighter);
    color: var(--primary-dark);
    transform: scale(1.05);
}

.btn-action.text-danger:hover {
    background: #fee2e2;
