                                <span class="card-badge completado">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:inline;margin-right:2px;">
                                        <polyline points="20 6 9 17 4 12"/>
